generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String?
  passwordHash String   @map("password_hash")
  role         String   @default("member")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("users")
}

model Sermon {
  id        String   @id @default(uuid())
  title     String
  speaker   String
  audioUrl  String?  @map("audio_url")
  date      DateTime @default(now())
  createdAt DateTime @default(now()) @map("created_at")
  category  String?  @default("Sunday Service")

  @@map("sermons")
}

model Event {
  id          String   @id @default(uuid())
  title       String
  description String?
  bannerUrl   String?  @map("banner_url")
  eventDate   DateTime @map("event_date")
  createdAt   DateTime @default(now()) @map("created_at")
  category    String?  @default("Church Event")
  location    String?  @default("Main Auditorium")
  time        String?  @default("8:00 AM")

  @@map("events")
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  phone     String
  email     String?
  type      String?  @default("General")
  message   String
  church    String?  @default("LFC Iseyin")
  status    String   @default("new")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_messages")
}

model LiveStream {
  id        String   @id @default(uuid())
  isLive    Boolean  @default(false) @map("is_live")
  streamUrl String?  @map("stream_url")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("live_stream")
}
