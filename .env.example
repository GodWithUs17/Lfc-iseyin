# Living Faith Church Iseyin - Environment Variables
# Copy to .env and fill values

# Site URL (for SEO, sitemap)
VITE_SITE_URL=https://lfciseyin.org.ng

# Formspree endpoint for contact form emails
VITE_FORMSPREE_URL=https://formspree.io/f/xxxxxx

# Google Sheets webhook (optional)
VITE_GOOGLE_SHEET_URL=https://script.google.com/macros/s/xxx/exec

# YouTube Channel ID
VITE_YOUTUBE_CHANNEL_ID=UCxxxxxxxx

# WhatsApp number (without +, with country code)
VITE_WHATSAPP_NUMBER=2348031234567

# Admin password (change from default)
VITE_ADMIN_PASSWORD=winners2026

# Optional: Supabase (for future real-time backend)
# VITE_SUPABASE_URL=https://xxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJ...

# Optional: Google Analytics
# VITE_GA_ID=G-XXXXXXXXXX
